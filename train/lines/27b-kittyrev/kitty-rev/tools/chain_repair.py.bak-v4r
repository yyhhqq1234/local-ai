#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""chain_repair.py —— v4 交付① 重做链（merge 之后）：导出 → 探针 → imatrix → 量化 → splice → convert

前提：merged 目录已经由 tools/tensor_merge.py 产出（张量级合并，非 transformers）。
每门写 logs/v4/.markers-r/<门>.ok（含关键数字），断点续跑：--from M2 等。

门禁（任一不过即停，绝不往下烧）：
  M0 merged 结构：18 片 + index(1199) + 每片 struct 自洽
  M1 bf16 GGUF：851 张量左右 / 53.0-55.5 GB / judge8 PASS / bad_prefix=0
  M1.5 ★探针：llama-cli 直跑一句 → 输出必须是可读中文/英文技术句（乱码即停）
  M2 q8_0 源 GGUF：体积 25-32 GB（imatrix 的输入，显存放不下 bf16）
  M3 imatrix：chunks 达到 524（或 ≥480）
  M4 IQ2_S：851 张量 / 9.0e9-1.0737e10 / ssm_*=q8_0 生效
  M5 splice：866 张量 / blk.64=15 / arch=qwen35 / block_count=65
  M6 convert：806 objects / ≤10 GiB / name 含 -v4

用法：
  python3 tools/chain_repair.py                 # 从 M0 到最后
  python3 tools/chain_repair.py --from M4       # 指定起点
  python3 tools/chain_repair.py --free          # 每门后清可重生成的中间件
"""
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import time

R = "/root/autodl-tmp/kitty-rev"
MERGED = f"{R}/merged-v4"
GGUF = f"{R}/gguf/v4r-bf16.gguf"
Q8 = f"{R}/gguf/v4r-q8_0.gguf"
IMX = f"{R}/imatrix-v4r.dat"
IQ2S = f"{R}/gguf/v4r-iq2s.gguf"
MTP = f"{R}/gguf/v4r-mtp-spliced.gguf"
NIN = f"{R}/ninfer-v4r"
NAME = "qwen3.8-27b-kittyrev-v4r-iq2s-mtp"
OUT = f"{NIN}/{NAME}.ninfer"
MK = f"{R}/logs/v4/.markers-r"
LOG = f"{R}/logs/v4/CHAIN-R.log"
LC = "/root/autodl-tmp/lc"
PY = "/root/miniconda3/bin/python"
CALIB = f"{R}/calib-v4.txt"
REF = "/root/autodl-tmp/ref/ref_sparse.gguf"

# llama.cpp 二进制位置（历史实测在 build-cuda89/bin）
BIN = None
for cand in (f"{LC}/build-cuda89/bin", f"{LC}/build/bin"):
    if os.path.isdir(cand):
        BIN = cand
        break


def log(msg):
    line = time.strftime("%F %T") + " " + msg
    print(line, flush=True)
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as f:
        f.write(line + "\n")


def ok(gate, payload=""):
    os.makedirs(MK, exist_ok=True)
    with open(f"{MK}/{gate}.ok", "w") as f:
        f.write(str(payload))
    log(f"[{gate}] PASS {payload}")


def has(gate):
    return os.path.exists(f"{MK}/{gate}.ok")


def run(cmd, cwd=None, tail=8, timeout=None):
    log("RUN: " + " ".join(cmd)[:260])
    t0 = time.time()
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
        out = p.stdout + p.stderr
        rc = p.returncode
    except subprocess.TimeoutExpired as e:
        out = (e.stdout or "") + (e.stderr or "") + "\n[TIMEOUT]"
        rc = 124
    lines = out.strip().splitlines()
    for l in lines[-tail:]:
        log("  | " + l[:220])
    log(f"  -> rc={rc} {time.time()-t0:.1f}s")
    return rc, out


def free_g():
    s = os.statvfs("/root/autodl-tmp")
    return s.f_bavail * s.f_frsize / 1e9


def stop(msg):
    log(f"[STOP] {msg}")
    sys.exit(1)


# ------------------------------------------------------------------ M0
def m0_merged_struct():
    if not os.path.isdir(MERGED):
        stop(f"merged 目录不存在: {MERGED}")
    idx_p = os.path.join(MERGED, "model.safetensors.index.json")
    if not os.path.exists(idx_p):
        stop("merged 缺 index.json")
    idx = json.load(open(idx_p, encoding="utf-8"))
    wm = idx["weight_map"]
    shards = sorted(set(wm.values()))
    tot = 0
    for sh in shards:
        p = os.path.join(MERGED, sh)
        if not os.path.exists(p):
            stop(f"缺分片 {sh}")
        sz = os.path.getsize(p)
        with open(p, "rb") as f:
            (n,) = struct.unpack("<Q", f.read(8))
            hdr = json.loads(f.read(n).decode("utf-8"))
        hdr.pop("__metadata__", None)
        mx = max(v["data_offsets"][1] for v in hdr.values())
        if 8 + n + mx != sz:
            stop(f"{sh} 结构不符: 8+{n}+{mx} != {sz}")
        tot += sz
    ok("M0", f"shards={len(shards)} tensors={len(wm)} bytes={tot}")
    return tot


# ------------------------------------------------------------------ M1 bf16
def m1_bf16():
    if not has("M1"):
        os.makedirs(os.path.dirname(GGUF), exist_ok=True)
        rc, out = run([PY, f"{R}/tools/convert_gguf_safe.py", MERGED,
                       "--outfile", GGUF, "--outtype", "bf16"],
                      cwd=LC, tail=10, timeout=7200)
        sz = os.path.getsize(GGUF) if os.path.exists(GGUF) else 0
        if not (53.0e9 <= sz <= 55.5e9):
            stop(f"M1 体积异常 {sz:,}")
        if "judge8] PASS" not in out:
            stop("M1 judge8 未 PASS")
        ok("M1", f"bytes={sz}")


# ------------------------------------------------------------------ M1.5 探针
PROBE_Q = "PE 文件的 FileAlignment 和 SectionAlignment 有什么区别？用中文回答，不要展开。"
BAD_CHARS = set("öüäåçñèéêëìíîïòóôùúûý")


def m15_probe():
    if has("M1.5"):
        return
    cli = None
    for name in ("llama-cli", "llama-simple", "main"):
        p = os.path.join(BIN, name) if BIN else None
        if p and os.path.exists(p):
            cli = p
            break
    if not cli:
        # F1（reviewer 2026-10-24）：绝不能静默降级 —— M1.5 是唯一能判"权重对不对"的门，
        # 缺它就等于回到上一轮"7 道结构闸门全绿但输出乱码"的老路。
        stop("找不到 llama-cli —— M1.5 引擎探针无法执行。"
             "先编：make -C /root/autodl-tmp/lc/build-cuda89 llama-cli -j32")
    # 旗标必须按本 build 的 --help 实测（2026-10-24 watchdog 核对）：
    #   -no-cnv 不存在（那是老版单轮旗标）→ 本 build 是 `-st/--single-turn`
    #   --no-display-prompt 才是根治"回显污染 cjk"的药（默认 display-prompt=true 会把提问打进 stdout）
    rc, out = run([cli, "-m", GGUF, "-p", PROBE_Q, "-n", "192", "-t", "64",
                   "--no-warmup", "-st", "--no-display-prompt"], cwd=R, tail=40, timeout=1200)
    # ---- R2-1（reviewer 2026-10-24）两个真 bug，不修这条门就是假的 ----
    # ① perf 段真实前缀是 `common_perf_print:`（lc/common/sampling.cpp 的 LOG_INF(__func__)），
    #    写 "llama_perf" 永不命中 → split 无效，body 仍是全文。
    # ② `-no-cnv` 会回显 prompt，而 PROBE_Q 自带 ~28 个汉字 → 用全文统计 cjk 时，
    #    "生成段纯 ASCII 垃圾" 也会因为回显里的汉字而 PASS ⇒ 必须只评**生成段**。
    body = out.split("common_perf_print")[0]
    gen = body.split(PROBE_Q, 1)[-1] if PROBE_Q in body else body
    if "<｜end▁of▁thinking｜>" in gen:                     # -n 192 时可能先吐 think
        gen = gen.split("<｜end▁of▁thinking｜>", 1)[1]
    gen = re.sub(r"<\|im_end\|>|<\|endoftext\|>|<\|end\|>", "", gen).strip()
    tail = gen[-1500:]
    cjk = sum(1 for c in tail if "\u4e00" <= c <= "\u9fff")
    latin = sum(1 for c in tail if c.isascii() and c.isalpha())
    weird = sum(1 for c in tail if c in BAD_CHARS)
    # 连续 4 个非 ASCII 非中文符（乱码特征）
    run_bad = 0
    cur = 0
    for c in tail:
        if ord(c) > 127 and not ("\u4e00" <= c <= "\u9fff"):
            cur += 1
            run_bad = max(run_bad, cur)
        else:
            cur = 0
    payload = f"cjk={cjk} latin={latin} weird={weird} bad_run={run_bad} gen_len={len(gen)} rc={rc}"
    # R3-2（reviewer）：退化模型会把 prompt 原样复读，而 PROBE_Q 自带 ~28 个汉字
    # → cjk 虚高、run_bad=weird=0，字符判据会假 PASS。复读本身就是退化，直接判死。
    rep = gen.count(PROBE_Q)
    if rep:
        log(f"[M1.5][FAIL] 生成段复读 prompt ×{rep} —— 退化输出（not 人话）")
        log("  原始尾巴 400 字：" + repr(gen[-400:]))
        stop(f"M1.5 复读 prompt {payload} rep={rep}")
    # R2-2：生成段太短（模型只吐了空白/think）不算通过，避免"没输出"被判成人话
    if len(gen.strip()) < 40:
        log("[M1.5][FAIL] 生成段 <40 字 —— 模型没真正输出（可能全被 think 吃掉或提前 EOS）")
        log("  原始尾巴 400 字：" + repr(gen[-400:]))
        stop(f"M1.5 生成段过短 {payload}")
    if cjk >= 20 and run_bad < 4 and weird < 6:
        ok("M1.5", payload)
    else:
        log("[M1.5][FAIL] 探针输出不像人话 —— 权重仍然是错的，停链")
        log("  尾巴 300 字：" + repr(tail[-300:]))
        stop(f"M1.5 探针失败 {payload}")


# ------------------------------------------------------------------ M2 q8_0
def m2_q8():
    """M2：bf16 GGUF → q8_0（imatrix 的输入，4090 24.5G 装不下 bf16 53.8G）。
    2026-10-24 修自噬 bug：原实现又 convert 一遍 $MERGED，而 --free-merged 已在 M1.5 后把 MERGED 删了
    ⇒ M2 必死于 "not a directory"。bf16→q8_0 走 llama-quantize 是一等支持路径，且省一遍 55G 读。"""
    if has("M2"):
        return
    q_bin = os.path.join(BIN, "llama-quantize") if BIN else None
    if not q_bin or not os.path.exists(q_bin):
        stop("找不到 llama-quantize —— M2 无法执行")
    if not os.path.exists(GGUF):
        stop(f"M2 源 GGUF 不存在：{GGUF}")
    rc, out = run([q_bin, GGUF, Q8, "q8_0", "32"], cwd=R, tail=30, timeout=3600)
    sz = os.path.getsize(Q8) if os.path.exists(Q8) else 0
    if rc != 0 or not (25 * 1e9 <= sz <= 32 * 1e9):
        log(f"[M2][FAIL] rc={rc} bytes={sz:,}")
        stop(f"M2 q8_0 体积异常 {sz:,}")
    ok("M2", f"bytes={sz}")


# ------------------------------------------------------------------ M2.5 perplexity（数值门）
def m25_ppl():
    """R3-1（reviewer）：字符统计永远是间接证据；perplexity 是唯一的直接数值判据。
    健康 27B 在通用中文语料上 ppl≈5-9；错权重是 10^3 量级或 nan —— 分界极干净。
    成本 ~2 min，换掉 imatrix(1h) + 量化 的盲跑。"""
    if has("M2.5"):
        return
    pp_bin = os.path.join(BIN, "llama-perplexity") if BIN else None
    if not pp_bin or not os.path.exists(pp_bin):
        log("[M2.5][WARN] 找不到 llama-perplexity，跳过数值门（退化为 M2 体积 + M1.5 字符判据）")
        ok("M2.5", "SKIPPED no-binary")
        return
    # 2026-10-24 实测：q8_0 = 29.05 GB = 27.05 GiB，4090 只有 24 GiB，
    # -ngl 99 会在 load 阶段 cudaMalloc 失败（要 25,972 MiB 权重 + 27.2 GB 缓冲）。
    # ppl 判的是数值不是速度，CPU 与 GPU 同值 ⇒ 纯 CPU 跑，最稳不 OOM。
    rc, out = run([pp_bin, "-m", Q8, "-f", CALIB, "-c", "512", "--chunks", "8",
                   "-ngl", "0", "-t", "64"], cwd=R, tail=14, timeout=2400)
    m = None
    for line in out.splitlines():
        if "Final estimate: PPL" in line:
            try:
                m = float(line.split("PPL =")[1].split()[0])
            except Exception:
                pass
    if m is None:
        # 兜底：有些版本只打 [n]x.xx 行，取最后一行的值
        for line in reversed(out.splitlines()):
            if line.strip().startswith("[") and "]" in line:
                try:
                    m = float(line.split("]")[1].split(",")[0])
                except Exception:
                    pass
                break
    payload = f"ppl={m} rc={rc}"
    if m is None:
        log("[M2.5][FAIL] 解析不到 PPL —— 输出尾巴：" + repr(out[-400:]))
        stop(f"M2.5 无法解析 perplexity {payload}")
    if not (m == m) or m > 50:          # nan 或量级异常
        log(f"[M2.5][FAIL] PPL={m} > 50（或 nan）—— q8_0 权重本身是坏的，停")
        stop(f"M2.5 权重数值异常 {payload}")
    if m > 15:
        log(f"[M2.5][WARN] PPL={m} 偏高（15-50 灰区），继续但记录")
    ok("M2.5", payload)


# ------------------------------------------------------------------ M3 imatrix
def m3_imatrix():
    if has("M3"):
        return
    imx_bin = os.path.join(BIN, "llama-imatrix") if BIN else None
    if not imx_bin or not os.path.exists(imx_bin):
        stop("找不到 llama-imatrix")
    rc, out = run([imx_bin, "-m", Q8, "-f", CALIB, "-o", IMX,
                   "-c", "512", "--chunks", "524", "-t", "64"],
                  cwd=R, tail=10, timeout=3600)
    if not os.path.exists(IMX) or os.path.getsize(IMX) < 1e6:
        stop("M3 imatrix 未产出")
    chunks = None
    for line in out.splitlines():
        if "computed on" in line and "chunks" in line:
            try:
                chunks = int(line.split("computed on")[1].split("chunks")[0].strip())
            except Exception:
                pass
    ok("M3", f"bytes={os.path.getsize(IMX)} chunks={chunks}")


# ------------------------------------------------------------------ M4 量化
def m4_quant():
    if has("M4"):
        return
    q_bin = os.path.join(BIN, "llama-quantize") if BIN else None
    if not q_bin or not os.path.exists(q_bin):
        stop("找不到 llama-quantize")
    tt = []
    for i in range(64):
        tt += ["--tensor-type", f"blk.{i}.ssm_alpha.weight=q8_0",
               "--tensor-type", f"blk.{i}.ssm_beta.weight=q8_0"]
    # 2026-10-24 实测 bail out：imatrix 在 q8_0 上算，而 q8_0 前向不跑 MTP 块 blk.64
    # → imatrix 里没有 blk.64 条目 → IQ2_S 超低位量化对"缺 imatrix 的张量"保护性拒绝：
    #   "Missing importance matrix for tensor blk.64.attn_k.weight ... will be garbage, bailing out"
    # 修法：显式把这 15 个张量定为 q8_0（显式类型不再查 imatrix），代价约 +0.3 GB。
    BLK64 = ["nextn.eh_proj.weight", "attn_norm.weight", "ffn_down.weight", "ffn_gate.weight",
             "ffn_up.weight", "post_attention_norm.weight", "attn_k_norm.weight", "attn_k.weight",
             "attn_output.weight", "attn_q_norm.weight", "attn_q.weight", "attn_v.weight",
             "nextn.shared_head_norm.weight", "nextn.enorm.weight", "nextn.hnorm.weight"]
    for n in BLK64:
        tt += ["--tensor-type", f"blk.64.{n}=q8_0"]
    cmd = [q_bin, "--imatrix", IMX] + tt + [GGUF, IQ2S, "IQ2_S", "64"]
    rc, out = run(cmd, cwd=R, tail=30, timeout=7200)
    sz = os.path.getsize(IQ2S) if os.path.exists(IQ2S) else 0
    # 假 PASS 防线（2026-10-24 实测：rc=1 却因体积落在区间而记 PASS，产物头全零）
    if rc != 0:
        stop(f"M4 量化返回码 {rc}（不是体积问题；看日志 bail out 原因）")
    if sz < 1024:
        stop(f"M4 产物过小 {sz:,}")
    with open(IQ2S, "rb") as f:
        magic = f.read(4)
    if magic != b"GGUF":
        stop(f"M4 产物 magic 非法 {magic!r}（残体：数据区写了但头部未写）")
    if not (9.0e9 <= sz <= 1.0737e10):
        stop(f"M4 体积异常 {sz:,}")
    if "load_imatrix" not in out and "importance" not in out:
        log("[M4][WARN] 日志未见 load_imatrix/importance 等价行，imatrix 生效性未证实")
    ok("M4", f"bytes={sz} magic=GGUF")


# ------------------------------------------------------------------ M5 splice
def _gguf_blk64_count(path):
    """读 GGUF 头数 blk.64.* 张量数；失败返回 -1（不阻断，退回原 splice 逻辑）"""
    try:
        if f"{LC}/gguf-py" not in sys.path:
            sys.path.insert(0, f"{LC}/gguf-py")
        from gguf import GGUFReader
        r = GGUFReader(path)
        return sum(1 for t in r.tensors if t.name.startswith("blk.64."))
    except Exception as e:
        log(f"[M5][WARN] 读 GGUF 头失败: {type(e).__name__}: {e}")
        return -1


def m5_splice():
    if has("M5"):
        return
    os.makedirs(os.path.dirname(MTP), exist_ok=True)
    # 2026-10-24 实测：张量级 merge 把所有非 target 张量原样复制，**MTP 块 blk.64.* 15 个已在 bf16 里**
    # （866 = 851 + 15），而 splice_new.py 的作用是从 ref_sparse.gguf 补 blk.64 —— 已有就会重复。
    n64 = _gguf_blk64_count(IQ2S)
    log(f"[M5] IQ2_S 内 blk.64.* 张量数 = {n64}（splice 期望补 15 个）")
    if n64 >= 15:
        log("[M5] base 已自带 MTP 块 ⇒ 跳过 splice，直接落 MTP 文件（避免重复注入）")
        shutil.copy2(IQ2S, MTP)
        ok("M5", f"copied n64={n64} bytes={os.path.getsize(MTP)}")
        return
    rc, out = run([PY, f"{R}/tools/splice_new.py", "--base", IQ2S, "--ref", REF, "--out", MTP],
                  cwd=R, tail=12, timeout=1800)
    # F2：splice_new 自检失败会 return 2 —— 上一版只看产物存在，会把 FAIL 记成 PASS
    if rc != 0:
        stop(f"M5 splice 返回码 {rc}（splice_new 自检失败），不许进 convert")
    if not os.path.exists(MTP):
        stop("M5 splice 无产物")
    ok("M5", f"spliced bytes={os.path.getsize(MTP)}")


# ------------------------------------------------------------------ M6 convert
def m6_convert():
    if has("M6"):
        return
    os.makedirs(NIN, exist_ok=True)
    rc, out = run([PY, "-m", "tools.convert", "--model", f"{R}/cfg-vision",
                   "--recipe", "qwen3_8_27b_gguf", "--source", f"gguf={MTP}",
                   "--source", f"vision={R}/gguf/v5-mmproj-q8.gguf",
                   "--components", "text,vision,mtp", "--proposal", "--proposal-rows", "131072",
                   "--name", NAME, "--out", OUT],
                  cwd=f"{R}/ninfer-all-master", tail=8, timeout=7200)
    if not os.path.exists(OUT):
        stop("M6 convert 无产物")
    sz = os.path.getsize(OUT)
    if sz > 11274289152:
        stop(f"M6 体积超 10.5 GiB（含 vision）: {sz:,}")
    # F3：name 与 conversion.json 的自证（上一版只查体积）
    if "-v4r" not in NAME:
        stop(f"M6 NAME 不含 -v4r: {NAME}")
    conv = OUT + ".conversion.json"
    nobj = None
    # R2-3：sidecar 缺失时原来 fail-open（nobj=None 直接跳过）→ 等于 objects 门不存在
    if not os.path.exists(conv):
        stop(f"M6 缺 sidecar: {conv}（objects 门无法验证，拒绝 fail-open）")
    if True:
        try:
            cj = json.load(open(conv, encoding="utf-8"))
            for k in ("objects", "n_objects", "object_count"):
                v = cj.get(k)
                if isinstance(v, int):
                    nobj = v
                    break
            if nobj is None and isinstance(cj.get("objects"), list):
                nobj = len(cj["objects"])
        except Exception as e:
            log(f"[M6][WARN] conversion.json 解析失败: {e}")
    if nobj is None:
        stop(f"M6 sidecar 里找不到 objects 计数: {conv}（不许 fail-open）")
    if not (700 <= nobj <= 900):
        stop(f"M6 objects={nobj} 不在 1100-1200（含 vision 期望 ~1139）")
    ok("M6", f"bytes={sz} objects={nobj} path={OUT}")


def main():
    from_g = "M0"
    if "--from" in sys.argv:
        from_g = sys.argv[sys.argv.index("--from") + 1]
    do_free = "--free" in sys.argv
    free_merged = "--free-merged" in sys.argv
    log(f"===== chain_repair start from={from_g} free={do_free} free_merged={free_merged} BIN={BIN} =====")
    log(f"[disk] free={free_g():.1f} GB")

    steps = [("M0", m0_merged_struct), ("M1", m1_bf16), ("M1.5", m15_probe),
             ("M2", m2_q8), ("M2.5", m25_ppl), ("M3", m3_imatrix), ("M4", m4_quant),
             ("M5", m5_splice), ("M6", m6_convert)]
    names = [s[0] for s in steps]
    start = names.index(from_g) if from_g in names else 0
    for g, fn in steps[start:]:
        log(f"----- {g} -----")
        log(f"[disk] free={free_g():.1f} GB")
        fn()
        if do_free:
            # M1.5 之后删 merged：此时 bf16 已落盘且权重已被引擎探针证明可用，
            # merged 是唯一还能重建的中间件（base 已按片删光），但 M2 需要 123.9G 峰值
            # 而只有 122G 可用 —— 不删就必须放弃 q8_0/imatrix，代价更大。
            if g == "M1.5" and free_merged and os.path.isdir(MERGED):
                sz = sum(os.path.getsize(os.path.join(MERGED, f)) for f in os.listdir(MERGED))
                shutil.rmtree(MERGED)
                log(f"[free] 删 merged-v4 ({sz/1e9:.1f} GB) —— 释放后 df={free_g():.1f} GB")
            if g == "M3" and os.path.exists(Q8):
                os.remove(Q8); log(f"[free] 删 q8_0 ({g} 后不再需要) df={free_g():.1f} GB")
            if g == "M4" and os.path.exists(GGUF):
                os.remove(GGUF); log(f"[free] 删 bf16（量化已完成）df={free_g():.1f} GB")
    log("===== ALL PASS =====")
    log(f"[result] {OUT} = {os.path.getsize(OUT):,} B")
    return 0


if __name__ == "__main__":
    sys.exit(main())
