{
  "name": "agent-traj ctx4096 chunked",
  "created": "2026-10-28",
  "purpose": "把超过 ctx 4096 的轨迹样本按自然边界切分成多段，零内容丢失，用于 OxCoder-9B 后训练 2A/2C 阶段",
  "generator": "train/scripts/chunk_train_samples.py",
  "params": {
    "ctx": 4096,
    "overlap_tokens": 256,
    "carry_chars": 800,
    "base_overhead": 64,
    "split_prefs": ["\\n[CALL ", "\\n\\n", "\\n"],
    "min_advance": "max(16, budget//4)"
  },
  "why_ctx_4096": {
    "measured_step_time_ctx4096": "26.9 s (iter2 steady 15.1 s)",
    "measured_step_time_ctx8192": "1149.5 s — reserved 25.98 GiB 超出 11.91 GiB 显存，Windows WDDM 把系统内存当后备存储，数据经 PCIe 往返，慢 42×",
    "measured_ctx9216": "OOM",
    "conclusion": "ctx 4096 是 RTX 5070 Ti Laptop 12GB 的硬上限；checkpoint 不可关闭（关掉立即 OOM）"
  },
  "validation": {
    "char_coverage": "1.000000 (区间无缝覆盖 [0,len)，允许 overlap)",
    "over_ctx_rows": 0,
    "lossless_fail": 0,
    "all_ignore_rows": 0,
    "empty_assistant": 0,
    "label_check": "train/scripts/label_builder.py --scan"
  },
  "datasets": [
    {
      "name": "nemotron-swe/swe-8k",
      "path": "train/data/agent-traj/nemotron-swe/swe-8k-chunk4096.jsonl",
