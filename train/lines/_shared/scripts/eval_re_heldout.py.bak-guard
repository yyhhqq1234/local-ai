#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""RE adapter 能力验证 —— 用训练集真实样本做 held-out 续写对比

为什么要有这个脚本（第一版验证的教训）：
  eval_re_adapter.py 自造了 system prompt 和 5 个场景，结果 0/5 —— 但那不是
  adapter 的问题，是验证方法错了：
    · 自造 system 与训练数据的 system 不一致（"直接调用" vs "具体调用"）
    · 没给工具 schema，模型只能猜工具名 → 输出 kitty_memdump 这类不存在的工具
  正确做法：从训练集取真实样本，用其原始 system+user 喂模型，
  让模型续写，再和真实 assistant 对比。

判定维度：
  1. 工具名命中率：生成文本中的 kitty_* 工具名，有多少出现在真实 assistant 里
  2. 编造率：出现但不在真实 assistant 也不在工具白名单里的名字
  3. 首行相似度：生成开头与真实 assistant 开头的字符级相似度
  4. 与基座对比：同 prompt 下基座的表现

用法：
  # adapter vs 基座，取 10 条真实样本
  python eval_re_heldout.py --adapter train/out/re-stage1-fixed/final --n 10 --compare-base
"""

import argparse
import io
import json
import os
import random
import re
import sys

sys.stdout.reconfigure(encoding="utf-8")

import torch

BASE = "train/models/OxCoder-9B"
GIB = 2 ** 30
# ═══ 工具白名单：从 kitty 官方契约动态读取，永不手写 ═══
# 权威源：train/data/kitty-reverse/kitty-contracts/tools.json（64 个工具）
# 踩过的坑：手写白名单漏了 kitty_rea_binary / kitty_trail / kitty_apkscan /
# kitty_loop，把正确输出误判成"编造"。
_CONTRACT = os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
    "data", "kitty-reverse", "kitty-contracts", "tools.json",
)


def load_kitty_tools(path=_CONTRACT):
    """返回 (真实工具名集合, 来源说明)。读不到就退化为空集并告警。"""
    try:
        with io.open(path, "r", encoding="utf-8") as f:
            tools = json.load(f)
        names = {t["name"] for t in tools if isinstance(t, dict) and t.get("name")}
        if names:
            return names, "tools.json (%d 个)" % len(names)
    except Exception as e:
        print("[WARN] 无法从 %s 读取工具清单: %s" % (path, e))
    return set(), "空（读不到契约，所有 kitty_* 都会判成编造）"


KITTY_TOOLS, KITTY_TOOLS_SRC = load_kitty_tools()

# 已确认的幻觉样本（回归测试用：出现即判失败）
KNOWN_HALLUCINATIONS = {
    "kitty_dbvm",        # DBVM 是 dbvm_initialize() 内核动作，不是工具
    "kitty_file_info",
    "kitty_pe_info",
    "kitty_debug",
    "kitty_decompile",
    "kitty_search",
    "kitty_memdump",
    "kitty_module_info",
    "kitty_read_memory",
    "kitty_upx_check",
}


def load_model(adapter=None):
    from transformers import AutoModelForImageTextToText as AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig

    bnb = BitsAndBytesConfig(
        load_in_4bit=True, bnb_4bit_quant_type="nf4",
        bnb_4bit_use_double_quant=True, bnb_4bit_compute_dtype=torch.bfloat16,
    )
    tok = AutoTokenizer.from_pretrained(BASE)
    model = AutoModelForCausalLM.from_pretrained(
        BASE, device_map={"": 0}, low_cpu_mem_usage=True,
        attn_implementation="sdpa", quantization_config=bnb,
    )
    if adapter:
        from peft import PeftModel

        model = PeftModel.from_pretrained(model, adapter)
    for p in model.parameters():
        if p.dtype == torch.float32:
            p.data = p.data.to(torch.bfloat16)
    model.eval()
    inner = getattr(model, "model", None)
    if inner is not None and getattr(inner, "visual", None) is not None:
        inner.visual = None
        torch.cuda.empty_cache()
    print("[load] %s  allocated = %.2f GiB"
          % ("adapter" if adapter else "基座", torch.cuda.memory_allocated() / GIB))
    return model, tok


@torch.no_grad()
def gen(model, tok, system, user, max_new=300):
    msgs = []
    if system:
        msgs.append({"role": "system", "content": system})
    msgs.append({"role": "user", "content": user})
    text = tok.apply_chat_template(msgs, tokenize=False, add_generation_prompt=True)
    ids = tok(text, return_tensors="pt", add_special_tokens=False).to(model.device)
    out = model.generate(
        **ids, max_new_tokens=max_new, do_sample=False,
        temperature=None, top_p=None, pad_token_id=tok.eos_token_id,
    )
    return tok.decode(out[0][ids["input_ids"].shape[1]:], skip_special_tokens=True).strip()


def tools_in(text):
    """切出的工具名 → 归一到 64 白名单（含粘连拆分）

    ★ 2026-10-28 修正两处：
      ① 原正则只匹配 kitty_ 前缀，漏掉 6 个 reverse_* 工具
         （reverse_add_target/intent/obs/patch/asset、reverse_submit）
      ② 粘连：模型常写 `kitty_net action=capture`，正则会把空格后的词连读成
         `kitty_netaction`，误判编造。规则：token 若以某已知工具名为前缀 → 归到最长前缀。
    """
    raw = set(re.findall(r"(?:kitty|reverse)_[a-z0-9_]+", text or ""))
    out = set()
    for tok in raw:
        if tok in KITTY_TOOLS:
            out.add(tok)
            continue
        pref = [k for k in KITTY_TOOLS if tok.startswith(k)]
        out.add(max(pref, key=len) if pref else tok)
    return out


def first_line_sim(a, b):
    """字符级相似度（SequenceMatcher，跨格式差异可比较）

    ★ 2026-10-28 修正：原实现只算「公共前缀长度 / 较长者长度」，
      参考答案首行形如 `工具：kitty_xxx`，模型输出常以 `###`/`**`/`1.` 开头，
      第一个字符不同就 break → 恒为 0.000，指标完全失效（实测 10/10 全零）。
      改用 difflib.SequenceMatcher，能跨过格式差异反映真实文本相似度。
    """
    import difflib

    la = " ".join((a or "").split())[:200]
    lb = " ".join((b or "").split())[:200]
    if not la or not lb:
        return 0.0
    return difflib.SequenceMatcher(None, la, lb).ratio()


def three_part_score(text):
    """三段式结构合规（0-3）：训练集的核心输出模式

    「工具+理由」/「参数要点」/「判据·判读」三段命中几段。
    这比首行相似更能反映 adapter 是否学到目标格式。
    """
    t = text or ""
    keys = [
        ("理由", ("理由", "选它的理由", "为什么选")),
        ("参数", ("参数", "参数要点")),
        ("判据", ("判据", "判读", "判成功", "判失败", "才算过")),
    ]
    return sum(1 for _, alts in keys if any(k in t for k in alts))


def ngram_overlap(gen, gt, n=20):
    """n-gram 逐字重合率 —— 记忆化判据

    输出与参考答案的 n-gram 集合重合比例。>0.8 = 基本在背答案。
    """
    import re as _re

    def grams(s):
        s = _re.sub(r"\s+", "", s or "")
        return {s[i:i + n] for i in range(max(0, len(s) - n + 1))}

    g1, g2 = grams(gen), grams(gt)
    if not g1 or not g2:
        return 0.0
    return len(g1 & g2) / len(g2)



def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--adapter", default="train/out/re-stage1-fixed/final")
    ap.add_argument("--data", default="train/data/kitty-reverse/train-kitty-core.jsonl")
    ap.add_argument("--n", type=int, default=10)
    ap.add_argument("--seed", type=int, default=7)
    ap.add_argument("--max-new", type=int, default=300)
    ap.add_argument("--compare-base", dest="cmp", action="store_true")
    args = ap.parse_args()

    # 取真实样本（跳过头 20 条，避训练最密区）
    rows = []
    with io.open(args.data, "r", encoding="utf-8") as f:
        for i, line in enumerate(f):
            if i < 20:
                continue
            line = line.strip()
            if not line:
                continue
            o = json.loads(line)
            msgs = o.get("messages") or []
            sys_m = next((m["content"] for m in msgs if m["role"] == "system"), "")
            usr_m = next((m["content"] for m in msgs if m["role"] == "user"), "")
            asst_m = next((m["content"] for m in msgs if m["role"] == "assistant"), "")
            if sys_m and usr_m and asst_m:
                rows.append((sys_m, usr_m, asst_m))
    rng = random.Random(args.seed)
    picks = rng.sample(rows, min(args.n, len(rows)))
    print("工具白名单：%s（动态读取，非手写）" % KITTY_TOOLS_SRC)
    print("已知幻觉样本：%d 个（出现即标 ⚠新幻觉 之外，用于回归）" % len(KNOWN_HALLUCINATIONS))
    print("从 %s 抽 %d 条真实样本" % (args.data, len(picks)))

    def run(model, tag):
        hit_tool = 0
        fake_total = 0
        known_total = 0
        novel_total = 0
        sim_sum = 0.0
        three_sum = 0
        gram_sum = 0.0
        n_applicable = 0        # ★ 参考答案含 kitty_ 工具名的条数 = 命中率真实分母
        n_gram_memo = 0         # ★ n-gram 重合 >0.8 条数（背答案）
        detail = []
        for i, (s, u, a_gt) in enumerate(picks, 1):
            resp = gen(model, tok, s, u, args.max_new)
            gt_tools = tools_in(a_gt)
            gen_tools = tools_in(resp)
            inter = gt_tools & gen_tools
            fake = gen_tools - KITTY_TOOLS
            hallu_known = fake & KNOWN_HALLUCINATIONS
            hallu_novel = fake - KNOWN_HALLUCINATIONS
            sim = first_line_sim(resp, a_gt)
            three = three_part_score(resp)
            gram = ngram_overlap(resp, a_gt)
            ok = bool(inter) and not fake
            if gt_tools:
                n_applicable += 1
            if gram > 0.8:
                n_gram_memo += 1
            hit_tool += 1 if inter else 0
            fake_total += len(fake)
            known_total += len(hallu_known)
            novel_total += len(hallu_novel)
            sim_sum += sim
            three_sum += three
            gram_sum += gram
            detail.append({
                "i": i, "inter": sorted(inter), "fake": sorted(fake),
                "hallu_known": sorted(hallu_known), "hallu_novel": sorted(hallu_novel),
                "gt_tools": sorted(gt_tools), "sim": round(sim, 3),
                "three_part": three, "gram_overlap": round(gram, 3), "ok": ok,
                "resp_head": resp[:150].replace("\n", "⏎"),
                "gt_head": a_gt[:150].replace("\n", "⏎"),
            })
            fake_desc = ",".join(sorted(fake)) or "无"
            if hallu_novel:
                fake_desc += " ⚠新幻觉"
            # 参考答案本身无工具名 → 这条不计入命中率分母，标 NA
            mark = "✅" if ok else ("—" if not gt_tools else "❌")
            print("  [%s %2d] 命中=%-24s 编造=%-16s 三段=%d 相似=%.2f 重合=%.2f GT=[%s] %s"
                  % (tag, i, ",".join(sorted(inter)) or "无", fake_desc,
                     three, sim, gram, ",".join(sorted(gt_tools)) or "无", mark))
        n = len(picks)
        hit_rate = hit_tool / n_applicable if n_applicable else 0.0
        print("  → %s 汇总：" % tag)
        print("      工具命中 %d/%d（真实分母=%d，命中率 %.1f%%）"
              % (hit_tool, n, n_applicable, hit_rate * 100))
        print("      编造 %d（已知 %d / 新 %d）" % (fake_total, known_total, novel_total))
        print("      三段式均分 %.2f/3 | 文本相似 %.3f | n-gram 重合 %.3f | 背答案(>0.8) %d 条"
              % (three_sum / n, sim_sum / n, gram_sum / n, n_gram_memo))
        return {"tag": tag, "hit": hit_tool, "n": n, "n_applicable": n_applicable,
                "hit_rate": round(hit_rate, 4),
                "fake": fake_total, "fake_known": known_total, "fake_novel": novel_total,
                "three_part_avg": round(three_sum / n, 3),
                "sim": round(sim_sum / n, 3), "gram_avg": round(gram_sum / n, 3),
                "gram_memo_cnt": n_gram_memo, "detail": detail}

    print()
    print("=" * 78)
    print("adapter 验证")
    print("=" * 78)
    model, tok = load_model(args.adapter)
    ra = run(model, "A")

    rb = None
    if args.cmp:
        print()
        print("=" * 78)
        print("基座验证（同 prompt）")
        print("=" * 78)
        del model
        torch.cuda.empty_cache()
        bm, tok2 = load_model(None)
        tok = tok2
        rb = run(bm, "B")

    print()
    print("=" * 78)
    print("结论")
    print("=" * 78)

    def line(tag, r):
        print("  %-7s 命中 %d/%d（分母 %d，%.1f%%）| 编造 %d | 三段 %.2f/3 | 相似 %.3f | 重合 %.3f"
              % (tag, r["hit"], r["n"], r["n_applicable"], r["hit_rate"] * 100,
                 r["fake"], r["three_part_avg"], r["sim"], r["gram_avg"]))

    line("adapter", ra)
    if rb:
        line("基座", rb)
        if ra["hit_rate"] > rb["hit_rate"]:
            print("  → ✅ adapter 有提升（命中率 %.1f%% → %.1f%%，+%.1f pt）"
                  % (rb["hit_rate"] * 100, ra["hit_rate"] * 100,
                     (ra["hit_rate"] - rb["hit_rate"]) * 100))
        elif ra["three_part_avg"] > rb["three_part_avg"] + 0.5:
            print("  → ⚠ 命中率无提升，但三段式结构 +%.2f → 学到了格式，工具名仍靠猜"
                  % (ra["three_part_avg"] - rb["three_part_avg"]))
        else:
            print("  → ❌ 无显著提升")
        if ra["fake"] < rb["fake"]:
            print("  → ✅ 编造下降 %d → %d（-%d%%）"
                  % (rb["fake"], ra["fake"],
                     round((rb["fake"] - ra["fake"]) / rb["fake"] * 100) if rb["fake"] else 0))

    # 记忆化警告
    if ra["gram_memo_cnt"] > 0:
        print("  ⚠ 记忆化告警：%d/%d 条与参考答案 20-gram 重合 >0.8（在背答案）"
              % (ra["gram_memo_cnt"], ra["n"]))

    # 落盘
    out = "train/out/eval-heldout.json"
    with open(out, "w", encoding="utf-8") as f:
        json.dump({"adapter": ra, "base": rb}, f, ensure_ascii=False, indent=2)
    print("  明细 → %s" % out)


if __name__ == "__main__":
    main()
