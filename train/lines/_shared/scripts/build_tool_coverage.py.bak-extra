# ── 回答模板（三段式，与训练集一致；按 channel 区分参数要点）──────────
TPL_A = (
    "{tool} — action 取 {action}。\n"
    "\n"
    "选它的理由：{desc}（通道 {ch}）。\n"
    "参数要点：先把目标定死（pid 或模块名/路径），只读类先 status 探一次，"
    "动手类一次给全参数再发。\n"
    "判据：回包先看首段 OK/ERR，再取关键字段决定下一步；"
    "ERR 不要原地重试，按错误码修参数。"
)

# G3 记录写入通道：参数要点是「父记录 + 行数据 + 必填字段」，不是 pid/模块
TPL_G3 = (
    "{tool} — action 取 {action}。\n"
    "\n"
    "选它的理由：{desc}（通道 {ch}）。\n"
    "参数要点：parentId 只能引既有记录（不存在的父会拒写）；行数据一次给全，"
    "缺字段按占位符补齐再发，别分多次补。\n"
    "判据：回包给出新记录 id 即写入成功；出现 ERR 先看是父记录不存在还是必填项缺失，"
    "改完再发一次，不要原地重试。"
)

# 引擎/外部分析工具：参数要点是「目标路径 + 输出目录」
TPL_TOOL = (
    "{tool} — action 取 {action}。\n"
    "\n"
    "选它的理由：{desc}（通道 {ch}）。\n"
    "参数要点：目标路径（游戏目录 / 包文件 / APK）必须显式给全，输出目录一次定好；"
    "只读类先 status 探一次，确认外部工具在位再动手。\n"
    "判据：回包给出产物路径或清单即成功；报「工具未安装」先补依赖，"
    "报「格式不支持」再换等价路径。"
)


def pick_tpl(channel):
    ch = channel or ""
    if ch.startswith("reverse"):
        return TPL_G3
    if ch in ("rea-mcp", "ue", "unity", "godot", "engine", "apk", "mobile", "drce"):
        return TPL_TOOL
    # 引擎类的 channel 名不统一，用描述兜底
    return TPL_A


def render(tool, action, desc, ch):
    tpl = pick_tpl(ch)
    # 引擎类工具（名字里带 ue/unity/godot/rea/apk 且 channel 不是 A）用 TPL_TOOL
    if tpl is TPL_A and re.search(r"_(ue|unity|godot|rea|apk|il2cpp|cpp2il|fmodel|lua|assetrip|bepinex)", tool):
        tpl = TPL_TOOL
    return tpl.format(tool=tool, action=action, desc=desc, ch=ch)



def count_coverage(core_path):
    """统计每个工具在现有训练集里的 assistant 覆盖数"""
    tools = {t["name"] for t in json.load(open(CONTRACT, encoding="utf-8"))}
    cnt = {}
    with io.open(core_path, "r", encoding="utf-8") as f:
        for line in f:
            if not line.strip():
                continue
            o = json.loads(line)
            msgs = o.get("messages") or []
            a = next((m["content"] for m in msgs if m.get("role") == "assistant"), "")
            for t in set(re.findall(r"kitty_[a-z0-9_]+", a)):
                if t in tools:
                    cnt[t] = cnt.get(t, 0) + 1
    return tools, cnt


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--target", type=int, default=30, help="覆盖低于此值的工具才补")
    ap.add_argument("--per", type=int, default=0,
                    help="每个工具最多生成几条（0=用满意图库）")
    ap.add_argument("--force", default="",
                    help="强制补这些工具（逗号分隔），不受 --target 阈值限制。"
                         "例：--force kitty_pchain,kitty_dualview,kitty_acescan")
    ap.add_argument("--out", default=DEFAULT_OUT)
    args = ap.parse_args()

    tools, cnt = count_coverage(CORE)
    tool_meta = {t["name"]: t for t in json.load(open(CONTRACT, encoding="utf-8"))}

    need = [t for t in tools if cnt.get(t, 0) < args.target]
    if args.force:
        for t in args.force.split(","):
            t = t.strip()
            if t and t in tools and t not in need:
                need.append(t)
    need.sort(key=lambda t: cnt.get(t, 0))
    print("=" * 74)
    print("工具覆盖补强 —— 阈值 < %d，需补 %d 个工具" % (args.target, len(need)))
    print("=" * 74)

    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    n_out = 0
    missing_intents = []
    with io.open(args.out, "w", encoding="utf-8") as fo:
        for t in need:
            intents = INTENTS.get(t)
            if not intents:
                missing_intents.append(t)
                continue
            if args.per:
                intents = intents[:args.per]
            meta = tool_meta[t]
            actions = meta.get("actions") or ["status"]
            for i, u in enumerate(intents):
                act = actions[i % len(actions)]
                rec = {
                    "messages": [
                        {"role": "system", "content": SYSTEM},
                        {"role": "user", "content": u},
                        {"role": "assistant", "content": render(
                            t, act, meta.get("description", ""), meta.get("channel", "?"),
                        )},
                    ],
                    "_coverage": {"tool": t, "was": cnt.get(t, 0)},
                }
                fo.write(json.dumps(rec, ensure_ascii=False) + "\n")
                n_out += 1
            print("  %-24s 现有 %3d → 补 %d 条" % (t, cnt.get(t, 0), len(intents)))

    print()
    print("生成 %d 条 → %s" % (n_out, args.out))
    if missing_intents:
        print()
        print("⚠ 以下工具在 INTENTS 里没有手写意图（需补）：")
        for t in missing_intents:
            print("  %-24s 现有 %d" % (t, cnt.get(t, 0)))
    print("=" * 74)


if __name__ == "__main__":
    main()
