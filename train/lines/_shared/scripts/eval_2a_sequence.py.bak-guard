"""2A 轨迹判据 —— 工具调用序列匹配（LCS）

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
为什么是这个判据
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
2A 学的是「用工具完成长任务」。判「做对没」有三条路：
  ① 跑真实测试（pandas/numpy/pillow 的可运行环境）—— 最准，但本机装不全，不可行
  ② 人工抽检 —— 不可复现、不能进 CI、看不出 1-2 个百分点差异
  ③ **工具调用序列匹配** —— 可自动跑、不需环境，测「路径像不像」

选 ③。它不测「结果对不对」（那是 ① 的事），但能稳定回答：
  · 模型的第一步工具对不对（首工具命中）
  · 前 3 步的工具顺序对不对（前3命中）
  · 整条路径的工具序列与参考有多接近（LCS 覆盖率）

⚠ 局限：序列对 ≠ 任务完成。若将来环境装全，应补跑真实测试做交叉验证。

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
用法
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  python eval_2a_sequence.py --adapter train/out/re-r2-ckpt1400-snapshot --n 20
  python eval_2a_sequence.py --adapter "" --n 20          # 基座对照
  python eval_2a_sequence.py --adapter <path> --max-new 1200 --seed 7
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
"""
import argparse
import io
import json
import os
import random
import re
import sys

import torch

sys.stdout.reconfigure(encoding="utf-8")

HERE = os.path.dirname(os.path.abspath(__file__))
TRAIN_ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)

BASE = os.path.join(TRAIN_ROOT, "models", "OxCoder-9B")
DATA = os.path.join(TRAIN_ROOT, "data", "agent-traj", "traj-all-capped.jsonl")
GIB = 2 ** 30
PAT = re.compile(r"(?:kitty|reverse)_[a-z0-9_]+")


def lcs_len(a, b):
    """最长公共子序列长度（工具名序列比对，不是字符）"""
    if not a or not b:
        return 0
    m = len(b)
    prev = [0] * (m + 1)
    for x in a:
        cur = [0] * (m + 1)
        for j, y in enumerate(b, 1):
            cur[j] = prev[j - 1] + 1 if x == y else max(prev[j], cur[j - 1])
        prev = cur
    return prev[m]


def extract_seq(text, tools):
    out = []
    for t in PAT.findall(text or ""):
        if t in tools:
            out.append(t)
        else:
            pref = [k for k in tools if t.startswith(k)]
            if pref:
                out.append(max(pref, key=len))
    return out


def load_model(adapter=None):
    from transformers import AutoModelForImageTextToText, AutoTokenizer, BitsAndBytesConfig
    from peft import PeftModel

    bnb = BitsAndBytesConfig(
        load_in_4bit=True, bnb_4bit_quant_type="nf4",
        bnb_4bit_use_double_quant=True, bnb_4bit_compute_dtype=torch.bfloat16,
    )
    tok = AutoTokenizer.from_pretrained(BASE)
    model = AutoModelForImageTextToText.from_pretrained(
        BASE, device_map={"": 0}, low_cpu_mem_usage=True,
        attn_implementation="sdpa", quantization_config=bnb,
    )
    if adapter:
        model = PeftModel.from_pretrained(model, adapter)
    for p in model.parameters():
        if p.dtype == torch.float32:
            p.data = p.data.to(torch.bfloat16)
    model.eval()
    inner = getattr(model, "model", None)
    if inner is not None and getattr(inner, "visual", None) is not None:
        inner.visual = None
        torch.cuda.empty_cache()
    print("[load] %s  allocated = %.2f GiB"
          % ("adapter" if adapter else "基座", torch.cuda.memory_allocated() / GIB))
    return model, tok


@torch.no_grad()
def gen(model, tok, system, user, max_new):
    msgs = []
    if system:
        msgs.append({"role": "system", "content": system})
    msgs.append({"role": "user", "content": user})
    text = tok.apply_chat_template(msgs, tokenize=False, add_generation_prompt=True)
    ids = tok(text, return_tensors="pt", add_special_tokens=False).to(model.device)
    # 长 prompt：截断到 3500 token 留出生成空间（ctx 4096）
    if ids["input_ids"].shape[1] > 3500:
        ids = {"input_ids": ids["input_ids"][:, :3500],
               "attention_mask": ids["attention_mask"][:, :3500]}
    out = model.generate(
        **ids, max_new_tokens=max_new, do_sample=False,
        temperature=None, top_p=None, pad_token_id=tok.eos_token_id,
    )
    return tok.decode(out[0][ids["input_ids"].shape[1]:], skip_special_tokens=True)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--adapter", default="train/out/re-r2-ckpt1400-snapshot")
    ap.add_argument("--data", default=DATA)
    ap.add_argument("--n", type=int, default=20)
    ap.add_argument("--seed", type=int, default=7)
    ap.add_argument("--max-new", type=int, default=1200)
    ap.add_argument("--out", default=None)
    args = ap.parse_args()

    tools = {t["name"] for t in json.load(
        open(os.path.join(TRAIN_ROOT, "data", "kitty-reverse",
                          "kitty-contracts", "tools.json"), encoding="utf-8"))}

    # 取样：只取「参考序列 >=3 个工具」的轨迹，否则比对无意义
    rows = []
    with io.open(args.data, "r", encoding="utf-8") as f:
        for line in f:
            if not line.strip():
                continue
            o = json.loads(line)
            msgs = o.get("messages") or []
            s = next((m["content"] for m in msgs if m.get("role") == "system"), "")
            u = next((m["content"] for m in msgs if m.get("role") == "user"), "")
            a = next((m["content"] for m in msgs if m.get("role") == "assistant"), "")
            seq = extract_seq(a, tools)
            if u.strip() and seq and len(seq) >= 3:
                rows.append((s, u, a, seq))

    print("=" * 80)
    print("2A 轨迹判据 —— 工具序列匹配")
    print("=" * 80)
    print("可用样本 %d 条（参考序列 >=3 工具）" % len(rows))
    if not rows:
        sys.exit("[FATAL] 没有合格样本")

    rng = random.Random(args.seed)
    picks = rng.sample(rows, min(args.n, len(rows)))
    print("抽取 %d 条（seed=%d）| adapter=%s" % (len(picks), args.seed, args.adapter or "基座"))
    print()

    model, tok = load_model(args.adapter)

    first_hit = 0
    top3_hit = 0
    cov_sum = 0.0
    detail = []
    for i, (s, u, a, ref) in enumerate(picks, 1):
        resp = gen(model, tok, s, u, args.max_new)
        got = extract_seq(resp, tools)
        f_hit = bool(got) and got[0] == ref[0]
        t3 = len(set(got[:3]) & set(ref[:3]))
        lcs = lcs_len(got, ref)
        cov = lcs / len(ref) if ref else 0.0
        first_hit += 1 if f_hit else 0
        top3_hit += t3
        cov_sum += cov
        detail.append({"i": i, "ref": ref[:8], "got": got[:8],
                       "first_hit": f_hit, "top3_inter": t3, "lcs": lcs,
                       "cov": round(cov, 3)})
        print("  [%2d] 首工具%s | 前3交集 %d | LCS %d/%d (%.0f%%)"
              % (i, "✅" if f_hit else "❌", t3, lcs, len(ref), cov * 100))
        print("       参考: %s" % " → ".join(ref[:6]))
        print("       模型: %s" % (" → ".join(got[:6]) if got else "（无工具调用）"))

    n = len(picks)
    print()
    print("=" * 80)
    print("汇总（%d 条）" % n)
    print("=" * 80)
    print("  首工具命中率   %d/%d = %.1f%%" % (first_hit, n, first_hit / n * 100))
    print("  前3工具交集均   %.2f / 3" % (top3_hit / n))
    print("  序列覆盖率(LCS) %.1f%%" % (cov_sum / n * 100))
    print()
    print("  判据参考：首工具 >=70% · 前3交集 >=1.5 · 序列覆盖 >=40%")

    out = args.out or os.path.join(
        TRAIN_ROOT, "out",
        "eval-2a-seq-%s.json" % (os.path.basename(os.path.dirname(args.adapter.rstrip("/\\")))
                                 + "-" + os.path.basename(args.adapter.rstrip("/\\"))
                                 if args.adapter else "base"))
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        json.dump({"adapter": args.adapter, "n": n,
                   "first_hit_rate": round(first_hit / n, 4),
                   "top3_inter_avg": round(top3_hit / n, 3),
                   "seq_cov_avg": round(cov_sum / n, 4),
                   "detail": detail}, f, ensure_ascii=False, indent=2)
    print()
    print("  明细 → %s" % out)


if __name__ == "__main__":
    main()
